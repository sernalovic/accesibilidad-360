# Variables de entorno de infraestructura (SPEC-003).
# Copiar a .env y completar con valores locales. No usar en producción.
# En producción se utiliza Neon PostgreSQL con su URL de conexión.
DATABASE_URL="Tu URL de conexión a la base de datos PostgreSQL"

# Autenticación Auth.js (SPEC-010). Generar con `npx auth secret`.
# No versionar nunca el valor real.
AUTH_SECRET="secreto_generado"

# Cloudinary (SPEC-050). Solo en servidor; no exponer el secret.
# No versionar nunca los valores reales.
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

#prueba commit