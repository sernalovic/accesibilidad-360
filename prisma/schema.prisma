// Esquema Prisma (SPEC-010 fase 010.2: modelo de datos de autenticación).
// La primera migración se generará cuando exista la base de datos Neon,
// durante la fase de despliegue.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles del dominio (001-domain-model.md + SPEC-010).
// Todo usuario nuevo recibe USER por defecto.
enum Role {
  USER
  MODERATOR
  ADMIN
}

// Usuario registrado.
//
// - `name` es obligatorio en el MVP porque el registro mediante
//   Credentials siempre solicita el nombre del usuario.
// - `passwordHash` es nullable para permitir una futura incorporación
//   de proveedores OAuth sin requerir una migración del esquema.
// - Nunca se almacenarán contraseñas en texto plano.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

// Requerido por Auth.js v5. Sin campos adicionales.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Requerido por Auth.js v5. Sin campos adicionales.
// Se utilizará cuando se activen las sesiones de base de datos;
// en esta fase las sesiones son JWT (ver lib/auth/auth.config.ts).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Requerido por Auth.js v5. Sin campos adicionales.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
